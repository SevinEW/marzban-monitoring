+package stats_test
+
+import (
+	"github.com/xtls/xray-core/app/stats"
+	"testing"
+)
+
+func TestLocalRelayAccountLifecycle(t *testing.T) {
+	for _, ip := range []string{"127.0.0.1", "[::1]", "::1", "198.51.100.2"} {
+		t.Run(ip, func(t *testing.T) {
+			m := stats.NewOnlineMap()
+			m.AddIP(ip)
+			m.AddIP(ip)
+			if m.Count() != 1 {
+				t.Fatal("same account/source should have one online entry")
+			}
+			m.RemoveIP(ip)
+			if m.Count() != 1 {
+				t.Fatal("remaining authenticated connection lost")
+			}
+			m.RemoveIP(ip)
+			m.RemoveIP(ip)
+			if m.Count() != 0 {
+				t.Fatal("disconnected account retained")
+			}
+		})
+	}
+}
